# ===================================================
# investIQ Backend - Production Environment Configuration
# ===================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=investiq_super_secret_jwt_key_2026_production

# 2. Neon Lakebase Postgres (Project: investIQ | ID: silent-truth-75316968 | Org: Vedant | ID: org-empty-moon-37720690)
# Pooled connection string (PgBouncer) for high-concurrency web and serverless traffic:
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-silent-truth-75316968-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Direct unpooled connection string:
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-silent-truth-75316968.us-east-2.aws.neon.tech/neondb?sslmode=require

NEON_PROJECT_ID=silent-truth-75316968
NEON_ORG_ID=org-empty-moon-37720690

# 3. Google Gemini AI API Key (Recommended)
# Get a free API Key at: https://aistudio.google.com/app/apikey
# Powers real-time AI news sentiment analysis, growth catalysts, and stock recommendations.
GEMINI_API_KEY=

# 4. Market News API Key (Optional)
# Get a free API Key at: https://newsapi.org or https://finnhub.io
# (Fallback: Built-in real-time financial RSS feeds stream automatically if left empty)
NEWS_API_KEY=

# 5. Stocks / Market Data API (Optional)
# Get a free API Key at: https://finnhub.io
# (Fallback: Built-in free Yahoo Finance live market pricing handles all Indian & US stocks and indices)
FINNHUB_API_KEY=
STOCKS_API_KEY=

# 6. Local DB File Path (fallback when DATABASE_URL is not set)
DATABASE_PATH=./src/data/investiq.db.json
